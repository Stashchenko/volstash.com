<script>
	// Yes, this is the actual date when I started my career in software development at EPAM ;)
	const dateStart = new Date("2011-09-11T09:00:00");
	const stableSpan = document.getElementById("exp-stable");
	const tickerSpan = document.getElementById("exp-ticker");

	if (stableSpan && tickerSpan) {
		const now = new Date();
		let years = now.getFullYear() - dateStart.getFullYear();
		let months = now.getMonth() - dateStart.getMonth();
		let days = now.getDate() - dateStart.getDate();

		if (days < 0) {
			const prevMonth = new Date(now.getFullYear(), now.getMonth(), 0);
			days += prevMonth.getDate();
			months--;
		}
		if (months < 0) {
			months += 12;
			years--;
		}

		const formatUnit = (value, unit) => `${value} ${value === 1 ? unit : unit + 's'}`;

		// Set stable text using textContent
		stableSpan.textContent = `${formatUnit(years, 'year')}, ${formatUnit(months, 'month')}, ${formatUnit(days, 'day')}`;

		function updateTicker() {
			const tickNow = new Date();

			const hrs = String(tickNow.getHours()).padStart(2, '0');
			const mins = String(tickNow.getMinutes()).padStart(2, '0');
			const secs = String(tickNow.getSeconds()).padStart(2, '0');

			tickerSpan.textContent = ` ${hrs}:${mins}:${secs} hours`;
		}

		updateTicker();
		setInterval(updateTicker, 1000);
	}
</script>
